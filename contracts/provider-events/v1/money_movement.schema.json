{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wurzburg/provider-events/v1/money_movement.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["currency", "amount_rials", "observed_remaining_credit_rials", "balance_observed_at", "initiated_by"],
  "properties": {
    "currency": { "const": "IRR" },
    "amount_rials": { "type": "string", "pattern": "^[0-9]+$" },
    "observed_remaining_credit_rials": { "type": "string", "pattern": "^-?[0-9]+$" },
    "balance_observed_at": { "type": "string", "format": "date-time" },
    "initiated_by": { "enum": ["PROVIDER", "CARDHOLDER", "PLATFORM"] }
  }
}
