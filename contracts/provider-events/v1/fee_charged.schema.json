{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wurzburg:provider-events:v1:fee_charged",
  "allOf": [
    { "$ref": "urn:wurzburg:provider-events:v1:envelope" },
    { "properties": { "event_type": { "const": "FEE_CHARGED" }, "data": { "type": "object", "additionalProperties": false, "required": ["currency", "amount_rials", "fee_source"], "properties": { "currency": { "const": "IRR" }, "amount_rials": { "type": "string", "pattern": "^[0-9]+$" }, "fee_source": { "enum": ["PROVIDER", "PROVIDER_USER"] } } } } }
  ]
}
